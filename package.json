{
  "name": "libra-labs-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply libra-labs-auth --remote",
    "db:migrate:local": "wrangler d1 migrations apply libra-labs-auth --local",
    "db:seed": "wrangler d1 execute libra-labs-auth --remote --file seeds/demo_commissions.sql",
    "db:seed:local": "wrangler d1 execute libra-labs-auth --local --file seeds/demo_commissions.sql"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@vitejs/plugin-react": "^4.5.2",
    "vite": "^6.3.5",
    "wrangler": "^4.153.0"
  }
}
